{
  "name": "get-firefox",
  "version": "8.0.0",
  "description": "Download the latest Firefox from the command line",
  "license": "MPL-2.0",
  "repository": "github:freaktechnik/get-firefox",
  "bugs": "https://github.com/freaktechnik/get-firefox/issues",
  "author": "freaktechnik (https://humanoids.be)",
  "type": "module",
  "main": "./index.js",
  "bin": {
    "get-firefox": "./bin/get-firefox.js"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "provenance": true
  },
  "scripts": {
    "lint": "eslint index.js lib/ bin/ test/ package.json",
    "test": "c8 ava",
    "coverage": "c8 report --reporter lcov",
    "start": "node bin/get-firefox.js"
  },
  "files": [
    "index.js",
    "bin/get-firefox-js",
    "lib/*.js",
    "lib/platforms.json"
  ],
  "keywords": [
    "fennec",
    "fxa",
    "firefox",
    "android",
    "nightly",
    "download",
    "mozilla-central",
    "trunk",
    "devedition",
    "esr"
  ],
  "dependencies": {
    "chalk": "^6.0.1",
    "decompress": "^4.2.1",
    "into-stream": "^9.1.0",
    "is-ci": "^4.1.0",
    "listr": "^0.14.3",
    "meow": "^14.1.0",
    "moz-download-url": "^3.0.0",
    "node-fetch": "^3.3.2",
    "sha": "^3.0.0",
    "taskcluster-client": "^87.1.3"
  },
  "devDependencies": {
    "@freaktechnik/eslint-config-node": "^14.1.0",
    "@freaktechnik/eslint-config-test": "^14.1.0",
    "ajv": "^8.20.0",
    "ava": "^8.2.0",
    "c8": "^12.0.0",
    "eslint": "^10.13.0",
    "tmp-promise": "^3.0.3"
  },
  "ava": {
    "timeout": "1m"
  }
}
